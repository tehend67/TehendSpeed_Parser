# Telegram API Credentials (получить на my.telegram.org)
API_ID=СЮДА API ID
API_HASH=СЮДА АПИ ХЕШ

# Bot Token (получить у @BotFather)
BOT_TOKEN=ТУТ ТОКЕН ВАШЕГО БОТА

# Pyrogram Session для Userbot-парсинга
# Оставь пустым для первого запуска — бот запросит phone + code
# Или используй готовую session string из @StringSessionBot
USER_SESSION_STRING=
USER_SESSION_NAME=userbot_parser

# База данных
DB_PATH=global_users.db

# Производительность (количество параллельных воркеров парсинга)
# Рекомендуется 3-5 для мощных серверов, 1-2 при частых FloodWait
WORKERS_COUNT=3

# Приветственное медиа (опционально)
# Если файл max.jpg существует — используется он, иначе URL
WELCOME_FILE=max.jpg
WELCOME_GIF=https://media.giphy.com/media/qgQUggAC3Pfv687qPC/giphy.gif

# Ограничение доступа (опционально)
# Пустое значение = бот открыт для всех
# Указанные ID через запятую/пробел = только для них
ADMIN_IDS=
